# Copy to .env.local and fill in. Never commit real .env files.

# Canonical site URL used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.tiruppurembossing.com

# Enquiry delivery for /api/quote and /api/contact (comma-separated channels).
#   file     -> save each enquiry + attachments to ENQUIRY_STORAGE_DIR (default)
#   webhook  -> POST to ENQUIRY_WEBHOOK_URL
#   log      -> development only: print enquiries to the server console
# Example: ENQUIRY_DELIVERY=file,webhook
ENQUIRY_DELIVERY=file

# Folder for the "file" channel (relative to the project root, or absolute).
ENQUIRY_STORAGE_DIR=storage/enquiries

# Webhook channel (Google Apps Script, Zapier, Make, n8n, your own API...).
ENQUIRY_WEBHOOK_URL=
# multipart = fields JSON + files as form-data; json = one JSON body, files base64-encoded
ENQUIRY_WEBHOOK_FORMAT=json
# Optional bearer token sent as the Authorization header.
ENQUIRY_WEBHOOK_SECRET=

# Admin panel (/admin). Required to enable the photo manager.
ADMIN_PASSWORD=
# Optional: random string used to sign admin sessions (defaults to a hash of the password).
ADMIN_SESSION_SECRET=
# Optional: where uploaded photos and content.json are stored (default: storage).
CONTENT_STORAGE_DIR=storage

# TE Chat - AI sales assistant (/api/chat, floating widget on the public site).
# Without this key, TE Chat still runs, but only returns matched website
# content instead of generated answers ("limited mode" - shown in Admin →
# TE Chat, and to visitors in the chat itself). Get a key at aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional: override the model TE Chat uses (see ai.google.dev/gemini-api/docs/models).
CHAT_MODEL=gemini-2.5-flash
